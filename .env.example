# Both APIM_BASE_URL and APIM_API_KEY are private configuration.
# Prefer Codespaces development-environment secrets for both values.
# GitHub prompts under "New with options", not every quick-create flow.
# For local setup, copy this file to ignored .env and fill in both values there.
# Never commit, log, screenshot, publish, or copy populated values into site/.
# Existing environment variables take precedence over .env.

# Use the instructor portal's private gateway base URL, without an endpoint path.
APIM_BASE_URL=

# Use only your individual participant gateway key.
APIM_API_KEY=

# Deployment names for the custom gateway, not backend Azure credentials.
# The routes you write read these; set MAI_IMAGE_DEPLOYMENT=mai-image to try
# MAI-Image-2.6 instead of Flash. Restart Flask after changing this file.
MAI_IMAGE_DEPLOYMENT=mai-image-flash
MAI_THINKING_DEPLOYMENT=mai-thinking

# Flask sends the key server-side in the api-key header to these gateway routes:
# POST /speech/tts
# POST /speech/transcribe?api-version=2025-10-15
# POST /mai/v1/images/generations
# POST /mai/v1/chat/completions
